return function(t)
	local Format = t.require("Format")
	t.test("troop counts read like the concept art", function()
		t.eq(Format.troops(950), "950")
		t.eq(Format.troops(1234), "1.2K")
		t.eq(Format.troops(9999), "9.9K")
		t.eq(Format.troops(12400), "12K")
		t.eq(Format.troops(480000), "480K")
		t.eq(Format.troops(1254000), "1.25M")
		t.eq(Format.troops(25300000), "25.3M")
	end)
	t.test("clock and percent", function()
		t.eq(Format.clock(125), "2:05")
		t.eq(Format.clock(-3), "0:00")
		t.eq(Format.percent(0.1234), "12.3%")
	end)
end
