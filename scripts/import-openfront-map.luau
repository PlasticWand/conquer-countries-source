-- lune run scripts/import-openfront-map <openfrontMapDir> <ModuleName> [referenceRoot]
-- Imports one OpenFront v0.35.2 map (resources/maps/<dir>/: manifest.json,
-- map.bin, map4x.bin, map16x.bin; CC BY-SA 4.0, credit "OpenFront") into
-- src/maps/<ModuleName>/ (Rojo: ServerStorage.OpenFrontMaps; the server hands
-- clients only the current map).
--   - init.luau holds the manifest and the chunk list for each size.
--   - Children are 256x256 chunks of OpenFront's terrain bytes, unchanged
--     (land, shoreline, ocean, magnitude), RLE + Base64 with a CRC, in
--     TileMap.decodeChunk's format.
--   - All three sizes are kept: a Normal game plays map.bin with map4x as its
--     minimap; a Compact game plays map4x with map16x.
-- OpenFront/MapLoader.luau reads them back.

local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

local Harness = require("../tests/harness")
local Shared = Harness.shared()
local Base64 = Harness.require(Shared.Base64)
local Crc32 = Harness.require(Shared.Crc32)

local dirName = assert(process.args[1], "usage: import-openfront-map <dir> <ModuleName> [referenceRoot]")
local moduleName = assert(process.args[2], "usage: import-openfront-map <dir> <ModuleName> [referenceRoot]")
local root = process.args[3] or "../reference/openfront-v0.35.2"
local src = `{root}/resources/maps/{dirName}`
local out = `src/maps/{moduleName}`

local CHUNK = 256
local SIZES = { { key = "map", file = "map.bin", prefix = "M" }, { key = "map4x", file = "map4x.bin", prefix = "Q" }, {
	key = "map16x",
	file = "map16x.bin",
	prefix = "S",
} }

-- Tag byte + LEB128 length per run (TileMap.decodeChunk's "rle").
local function rle(data: buffer): buffer
	local parts = {}
	local n = buffer.len(data)
	local i = 0
	while i < n do
		local tag = buffer.readu8(data, i)
		local j = i + 1
		while j < n and buffer.readu8(data, j) == tag do
			j += 1
		end
		local length = j - i
		local bytes = { tag }
		repeat
			local b = length % 128
			length = (length - b) / 128
			table.insert(bytes, if length > 0 then b + 128 else b)
		until length == 0
		table.insert(parts, string.char(table.unpack(bytes)))
		i = j
	end
	return buffer.fromstring(table.concat(parts))
end

local function luaString(s: string): string
	return string.format("%q", s)
end

local function luaValue(v: any, indent: string): string
	local t = typeof(v)
	if t == "string" then
		return luaString(v)
	elseif t == "number" or t == "boolean" then
		return tostring(v)
	elseif t == "table" then
		if #v > 0 or next(v) == nil then
			local items = {}
			for _, x in v do
				table.insert(items, luaValue(x, indent .. "\t"))
			end
			if #items == 0 then
				return "{}"
			end
			return "{ " .. table.concat(items, ", ") .. " }"
		end
		local keys = {}
		for k in v do
			table.insert(keys, k)
		end
		table.sort(keys)
		local items = {}
		for _, k in keys do
			local key = if string.match(k, "^[%a_][%w_]*$") then k else "[" .. luaString(k) .. "]"
			table.insert(items, `{indent}\t{key} = {luaValue(v[k], indent .. "\t")},`)
		end
		return "{\n" .. table.concat(items, "\n") .. "\n" .. indent .. "}"
	end
	error(`unsupported value type {t}`)
end

local manifest = serde.decode("json", fs.readFile(src .. "/manifest.json"))
if fs.isDir(out) then
	fs.removeDir(out)
end
fs.writeDir(out)

local header = "--!strict\n"
	.. `-- Generated by scripts/import-openfront-map.luau from OpenFront v0.35.2 resources/maps/{dirName}.\n`
	.. "-- Map data © OpenFront and Contributors, CC BY-SA 4.0; underlying geography credits in docs/LICENSING_PLAN.md.\n"
	.. "-- Do not edit; regenerate.\n"

local sizes = {}
local totalBytes = 0
for _, size in SIZES do
	local meta = manifest[size.key]
	local width, height = meta.width, meta.height
	local data = buffer.fromstring(fs.readFile(`{src}/{size.file}`))
	assert(buffer.len(data) == width * height, `{size.file}: expected {width * height} bytes`)
	local chunks = {}
	for cy = 0, math.ceil(height / CHUNK) - 1 do
		for cx = 0, math.ceil(width / CHUNK) - 1 do
			local x0, y0 = cx * CHUNK, cy * CHUNK
			local w, h = math.min(CHUNK, width - x0), math.min(CHUNK, height - y0)
			local raw = buffer.create(w * h)
			for row = 0, h - 1 do
				buffer.copy(raw, row * w, data, (y0 + row) * width + x0, w)
			end
			local packed = rle(raw)
			local encoding, payload = "rle", packed
			if buffer.len(packed) >= buffer.len(raw) then
				encoding, payload = "raw", raw
			end
			local name = string.format("%s%02d_%02d", size.prefix, cx, cy)
			local text = Base64.encode(payload)
			totalBytes += #text
			fs.writeFile(
				`{out}/{name}.luau`,
				header
					.. "return {\n"
					.. `\tcx = {cx},\n\tcy = {cy},\n\tw = {w},\n\th = {h},\n`
					.. `\tencoding = "{encoding}",\n\tdecodedLength = {w * h},\n`
					.. `\tchecksum = {Crc32.ofBuffer(raw)},\n\tdata = "{text}",\n}\n`
			)
			table.insert(chunks, { cx = cx, cy = cy, module = name })
		end
	end
	sizes[size.key] = { width = width, height = height, numLandTiles = meta.num_land_tiles, chunks = chunks }
end

local function chunkList(list: { any }): string
	local items = {}
	for _, c in list do
		table.insert(items, `\t\t\t\{ cx = {c.cx}, cy = {c.cy}, module = "{c.module}" },`)
	end
	return "{\n" .. table.concat(items, "\n") .. "\n\t\t}"
end

local sizeText = {}
for _, size in SIZES do
	local s = sizes[size.key]
	table.insert(
		sizeText,
		`\t\t{size.key} = \{\n\t\t\twidth = {s.width},\n\t\t\theight = {s.height},\n\t\t\tnumLandTiles = {s.numLandTiles},\n\t\t\tchunkSize = {CHUNK},\n\t\t\tchunks = {chunkList(
			s.chunks
		)},\n\t\t},`
	)
end

local rest = {
	nations = manifest.nations or {},
	additionalNations = manifest.additionalNations or {},
}
local init = header
	.. "return {\n"
	.. `\tschemaVersion = 1,\n\tsource = "openfront-v0.35.2/{dirName}",\n`
	.. `\tid = {luaString(manifest.id or moduleName)},\n\tname = {luaString(manifest.name or moduleName)},\n`
	.. "\tsizes = {\n"
	.. table.concat(sizeText, "\n")
	.. "\n\t},\n"
	-- Some nations have no flag, so the lists are typed loosely.
	.. "\tnations = (" .. luaValue(rest.nations, "\t") .. ") :: { any },\n"
	.. "\tadditionalNations = (" .. luaValue(rest.additionalNations, "\t") .. ") :: { any },\n"
	.. (if manifest.teamGameSpawnAreas
		then `\tteamGameSpawnAreas = {luaValue(manifest.teamGameSpawnAreas, "\t")},\n`
		else "")
	.. "}\n"
fs.writeFile(`{out}/init.luau`, init)
print(`{moduleName}: {#sizes.map.chunks}+{#sizes.map4x.chunks}+{#sizes.map16x.chunks} chunks, {math.floor(totalBytes / 1024)} KiB of Base64`)
